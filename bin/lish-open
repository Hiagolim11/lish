#!/usr/bin/env python3
"""Show images and spreadsheets in the Little Shell viewer.

Usage: lish-open ARQUIVO [ARQUIVO ...]
       lish-open --inline [--width COLUNAS] IMAGEM [IMAGEM ...]
"""

import json
import os
import socket
import sys

USAGE = """uso: lish-open ARQUIVO [ARQUIVO ...]
     lish-open --inline [--width COLUNAS] IMAGEM [IMAGEM ...]

Abre imagens (PNG, JPG, GIF, WebP, SVG...) e planilhas (CSV, TSV, XLSX, ODS)
numa aba de visualização do Little Shell.

  -i, --inline      desenha a imagem na própria saída do terminal
  -w, --width N     largura máxima em colunas (padrão: a largura do terminal)"""


def send(socket_path: str, request: dict) -> dict:
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as client:
        client.settimeout(5)
        client.connect(socket_path)
        client.sendall((json.dumps(request) + "\n").encode())
        data = b""
        while b"\n" not in data:
            chunk = client.recv(4096)
            if not chunk:
                break
            data += chunk
    return json.loads(data.decode() or "{}")


def show_inline(names: list[str], columns: int | None) -> int:
    """Draw images in the output; works without the viewer and over pipes."""
    import shutil
    from pathlib import Path

    sys.path.insert(0, str(Path(__file__).resolve().parent.parent))
    from littleshell.inline_image import render_file

    size = shutil.get_terminal_size((80, 24))
    width = min(columns or size.columns, size.columns)
    status = 0
    for name in names:
        path = os.path.expanduser(name)
        try:
            sys.stdout.write(render_file(path, width, max(4, size.lines - 2)))
            sys.stdout.flush()
        except Exception as error:  # GLib.Error: unknown format, broken file...
            print(f"lish-open: não foi possível desenhar {name}: {getattr(error, 'message', error)}", file=sys.stderr)
            status = 1
    return status


def main(argv: list[str]) -> int:
    if not argv or argv[0] in ("-h", "--help"):
        print(USAGE)
        return 0 if argv else 2
    if argv[0] in ("-i", "--inline"):
        names, columns = [], None
        arguments = iter(argv[1:])
        for argument in arguments:
            if argument in ("-w", "--width"):
                try:
                    columns = max(4, int(next(arguments)))
                except (StopIteration, ValueError):
                    print("lish-open: --width precisa de um número de colunas", file=sys.stderr)
                    return 2
            else:
                names.append(argument)
        if not names:
            print(USAGE)
            return 2
        return show_inline(names, columns)
    socket_path = os.environ.get("LISH_SOCKET")
    if not socket_path:
        print("lish-open: use este comando dentro do Little Shell.", file=sys.stderr)
        return 2
    status = 0
    for name in argv:
        path = os.path.abspath(os.path.expanduser(name))
        if not os.path.isfile(path):
            print(f"lish-open: arquivo não encontrado: {name}", file=sys.stderr)
            status = 1
            continue
        try:
            reply = send(socket_path, {"action": "open", "path": path, "pane": os.environ.get("LISH_PANE")})
        except (OSError, ValueError) as error:
            print(f"lish-open: o terminal não respondeu ({error}).", file=sys.stderr)
            return 1
        if not reply.get("ok"):
            print(f"lish-open: {reply.get('error', 'erro desconhecido')}", file=sys.stderr)
            status = 1
    return status


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
